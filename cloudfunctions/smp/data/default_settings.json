{
  "deepseek": {
    "base_url": "https://api.deepseek.com",
    "chat_model": "deepseek-flash",
    "max_retries": 3,
    "qps": 8,
    "search": {
      "endpoint": "/v1/tools/search",
      "query_field": "query",
      "count_field": "count",
      "count": 20,
      "extra_body": {
        "need_content": true
      },
      "results_path": [
        "results"
      ],
      "max_query_chars": 128,
      "date_operators": true,
      "lang": "zh,en",
      "ori_question": "{name}（{org}）近期的学术活动、学术获奖与学术成果",
      "min_rerank_score": 0.3
    },
    "fetch": {
      "endpoint": "/v1/tools/fetch",
      "url_field": "url"
    },
    "timeout_ms": 20000,
    "_doc": "字段依据 https://api-docs.deepseek.com/guides/search（2026-11-10 核对）",
    "thinking": "disabled"
  },
  "collect": {
    "member_queries": [
      "{name} {org} 学术",
      "{name} {org_short} 获奖 报告 论文",
      "{name} {org} 学术会议 特邀报告"
    ],
    "tiers": {
      "core_roles": [
        "指导委员会主任",
        "指导委员会副主任",
        "主任",
        "副主任",
        "秘书长",
        "副秘书长",
        "常务委员"
      ],
      "core_query_count": 2,
      "default_query_count": 1
    },
    "org_queries": [
      "中国中文信息学会 社会媒体处理专委会",
      "SMP {year} 社会媒体处理大会",
      "社会媒体处理专委会 SMP 活动"
    ],
    "date_tolerance_days": 3,
    "keep_undated": true,
    "verify_urls": false,
    "org_news_terms": [
      "社会媒体处理专委会",
      "社会媒体处理专业委员会",
      "全国社会媒体处理大会",
      "社会媒体处理大会"
    ],
    "batch_size": 24,
    "concurrency": 4,
    "content_max_chars": 1500
  },
  "disambiguation": {
    "confirm_threshold": 0.6,
    "reject_threshold": 0.4,
    "use_llm_for_ambiguous": true,
    "context_window": 60,
