    "monthly": {
      "min_items": 30,
      "max_items": 50,
      "min_score": 35,
      "per_member_cap": 3
    },
    "floor_score": 12,
    "category_caps": {
      "activity": 0.4,
      "influence": 0.2,
      "other": 0.1
    },
    "diversity_decay": 0.75
