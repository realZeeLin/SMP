/* ============================================================
   SMP 学术动态 · 设计规范（Design Tokens）
   风格：学术 · 简洁清爽 · 精致
   - 主色：墨蓝 #1B2B48（标题/主按钮），辅色：学术蓝 #2F5D8C，点缀：鎏金 #A8834A（期号/荣誉，克制使用）
   - 背景：暖白纸色 #F7F6F2，卡片纯白 + 1rpx 细线，圆角 16rpx，极轻阴影
   - 字体：标题用宋体（期刊感），正文用系统黑体，数字用等宽数字
   ============================================================ */
page {
  --ink: #1B2B48;
  --accent: #2F5D8C;
  --gold: #A8834A;
  --gold-soft: #F5EEDF;
  --text: #2B2F36;
  --sub: #6B717A;
  --muted: #9AA0A9;
  --line: #ECEAE4;
  --paper: #F7F6F2;
  --card: #FFFFFF;
  --green: #2F7A5B;
  --red: #B0524A;
  --serif: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", serif;
  --sans: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;

  background: var(--paper);
  color: var(--text);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.6;
  letter-spacing: 0.5rpx;
}

/* ---------- 布局 ---------- */
.container { padding: 24rpx 32rpx 48rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.flex1 { flex: 1; min-width: 0; }
.gap8 > view + view { margin-left: 16rpx; }

/* ---------- 文字 ---------- */
.serif { font-family: var(--serif); }
.h1 { font-family: var(--serif); font-size: 44rpx; font-weight: 700; color: var(--ink); letter-spacing: 2rpx; line-height: 1.35; }
.h2 { font-family: var(--serif); font-size: 34rpx; font-weight: 700; color: var(--ink); line-height: 1.4; }
.h3 { font-size: 30rpx; font-weight: 600; color: var(--ink); line-height: 1.5; }
.eyebrow { font-size: 20rpx; letter-spacing: 6rpx; color: var(--gold); text-transform: uppercase; }
.sub { color: var(--sub); font-size: 24rpx; }
.muted { color: var(--muted); font-size: 22rpx; }
.num { font-variant-numeric: tabular-nums; font-family: "DIN Alternate", "Helvetica Neue", var(--sans); }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.clamp2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* ---------- 卡片 ---------- */
.card { background: var(--card); border-radius: 16rpx; border: 1rpx solid var(--line); padding: 32rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(27, 43, 72, 0.04); }
.card-flat { background: var(--card); border-radius: 16rpx; border: 1rpx solid var(--line); margin-bottom: 24rpx; }
.hairline { height: 1rpx; background: var(--line); margin: 24rpx 0; }
.rule-gold { width: 48rpx; height: 4rpx; background: var(--gold); border-radius: 2rpx; }

/* ---------- 区块标题 ---------- */
.section-title { display: flex; align-items: baseline; margin: 40rpx 0 20rpx; }
.section-title .no { font-family: var(--serif); color: var(--gold); font-size: 28rpx; margin-right: 16rpx; font-weight: 700; }
.section-title .t { font-family: var(--serif); font-size: 32rpx; font-weight: 700; color: var(--ink); }
.section-title .more { margin-left: auto; color: var(--muted); font-size: 24rpx; }

/* ---------- 按钮 ---------- */
.btn { display: flex; align-items: center; justify-content: center; height: 84rpx; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; padding: 0 32rpx; }
.btn-primary { background: var(--ink); color: #fff; }
.btn-ghost { background: #fff; color: var(--ink); border: 1rpx solid #D9DCE2; }
.btn-gold { background: var(--gold); color: #fff; }
.btn-text { color: var(--accent); font-size: 26rpx; }
.btn-sm { height: 60rpx; font-size: 24rpx; padding: 0 24rpx; border-radius: 10rpx; }
.btn[disabled], .btn.disabled { opacity: 0.45; }
button.reset { margin: 0; padding: 0; background: none; border: none; line-height: inherit; font-size: inherit; color: inherit; }
button.reset::after { border: none; }

/* ---------- 标签 / 筹码 ---------- */
.chip { display: inline-flex; align-items: center; height: 44rpx; padding: 0 18rpx; border-radius: 22rpx; font-size: 22rpx; background: #F1F2F4; color: var(--sub); margin: 0 12rpx 12rpx 0; }
.chip.on { background: var(--ink); color: #fff; }
.tag-line { display: inline-flex; height: 36rpx; padding: 0 12rpx; align-items: center; border-radius: 6rpx; font-size: 20rpx; border: 1rpx solid #D9DCE2; color: var(--sub); }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; display: inline-block; margin-right: 10rpx; }

/* ---------- 分段控件 ---------- */
.segment { display: flex; background: #EFEDE7; border-radius: 12rpx; padding: 6rpx; }
.segment .seg { flex: 1; text-align: center; height: 60rpx; line-height: 60rpx; border-radius: 9rpx; font-size: 26rpx; color: var(--sub); }
.segment .seg.on { background: #fff; color: var(--ink); font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06); }

/* ---------- 进度条 ---------- */
.progress { height: 8rpx; background: #EEF0F3; border-radius: 4rpx; overflow: hidden; }
.progress .bar { height: 100%; background: linear-gradient(90deg, var(--accent), var(--ink)); border-radius: 4rpx; transition: width .4s; }

/* ---------- 统计格 ---------- */
.stats { display: flex; }
.stats .s { flex: 1; text-align: center; position: relative; }
.stats .s + .s::before { content: ""; position: absolute; left: 0; top: 12rpx; bottom: 12rpx; width: 1rpx; background: var(--line); }
.stats .v { font-size: 40rpx; color: var(--ink); font-weight: 700; }
.stats .k { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }

/* ---------- 底部操作栏 ---------- */
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; background: rgba(255, 255, 255, 0.96); border-top: 1rpx solid var(--line);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; z-index: 10; }
.action-bar .btn { flex: 1; }
.action-bar .btn + .btn { margin-left: 20rpx; }
.with-bar { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }

/* ---------- 表单 ---------- */
.field { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.field:last-child { border-bottom: none; }
.field .label { font-size: 24rpx; color: var(--sub); margin-bottom: 12rpx; }
.field input, .field textarea { font-size: 28rpx; color: var(--text); width: 100%; }
.field textarea { min-height: 120rpx; line-height: 1.7; }
.input-box { background: #F7F7F8; border-radius: 10rpx; padding: 18rpx 20rpx; }

/* ---------- 提示条 ---------- */
.banner { display: flex; align-items: center; padding: 20rpx 28rpx; border-radius: 12rpx; font-size: 24rpx; margin-bottom: 24rpx; }
.banner.gold { background: var(--gold-soft); color: #7D5F2E; }
.banner.blue { background: #E8EEF6; color: var(--accent); }
.banner .act { margin-left: auto; font-weight: 600; }

/* ---------- 头像（姓氏字） ---------- */
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #E8ECF3; color: var(--ink); font-family: var(--serif);
  font-size: 34rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar.lg { width: 128rpx; height: 128rpx; font-size: 56rpx; background: var(--ink); color: #F5EEDF; }
