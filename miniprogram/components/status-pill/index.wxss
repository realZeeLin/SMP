.pill { display: inline-flex; align-items: center; height: 44rpx; padding: 0 16rpx; border-radius: 22rpx; font-size: 24rpx; font-weight: 600; }
.blue { color: #007AFF; background: rgba(0, 122, 255, 0.15); }
.orange { color: #FF9500; background: rgba(255, 149, 0, 0.15); }
.green { color: #34C759; background: rgba(52, 199, 89, 0.15); }
.red { color: #FF3B30; background: rgba(255, 59, 48, 0.15); }
.gray { color: #8E8E93; background: rgba(142, 142, 147, 0.15); }
