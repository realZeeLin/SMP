<view class="with-toolbar pt24" wx:if="{{ev}}">
  <view class="group-header inset2">成稿</view>
  <view class="group">
    <view class="list">
      <view class="cell col">
        <text class="caption secondary">标题</text>
        <textarea class="headline ta" auto-height maxlength="60" value="{{headline}}" bindinput="onHeadline"/>
      </view>
      <view class="cell col">
        <text class="caption secondary">摘要</text>
        <textarea class="body ta" auto-height maxlength="300" value="{{blurb}}" bindinput="onBlurb"/>
      </view>
      <picker range="{{catNames}}" value="{{catIndex}}" bindchange="changeCat">
        <view class="cell" hover-class="cell-hover"><text class="title flex1">栏目</text><cat-tag category="{{ev.category}}"/><view class="chevron"></view></view>
      </picker>
    </view>
    <view class="group-footer">原题：{{ev.title}}</view>
  </view>

  <view class="group-header inset2"><text>重要性评分</text><text class="rounded">{{ev.scoreText}} 分</text></view>
  <view class="group">
    <view class="list">
      <view wx:for="{{factors}}" wx:key="k" class="cell">
        <text class="subhead fk">{{item.name}}</text>
        <view class="bar-track flex1"><view class="bar-fill" style="width:{{item.pct}}%"></view></view>
        <text class="subhead secondary rounded fv">{{item.v}}</text>
      </view>
    </view>
    <view class="group-footer">权重 × 因子 × 人物置信系数 {{ev.scoreDetail.confFactor}}{{ev.previouslyPublished ? ' × 跨期已发布降权' : ''}}{{ev.scoreDetail.bonus ? ' + 专委会动态加分' : ''}}</view>
  </view>

  <view class="group-header inset2">人物识别</view>
  <view class="group">
    <view class="list avatars">
      <view wx:for="{{ev.memberEvidence}}" wx:key="memberId" class="cell col" hover-class="cell-hover" bindtap="openMember" data-id="{{item.memberId}}">
        <view class="row">
          <view class="mono">{{item.initialChar}}</view>
          <view class="flex1 ml24"><view class="title">{{item.name}}</view><view class="sub">{{item.org}}</view></view>
          <view class="capsule {{item.status}}">{{item.statusName}} {{item.pct}}%</view>
          <view class="chevron"></view>
        </view>
        <view class="row wrap ev-chips"><text wx:for="{{item.evidence}}" wx:for-item="e" wx:key="*this" class="ev-chip">{{e}}</text></view>
      </view>
    </view>
    <view class="group-footer">判定方式：{{methodText}}。若识别有误，可在复核中标记“认错人”，今后各期不再匹配。</view>
  </view>

  <view class="group-header inset2"><text>报道来源</text><text>{{ev.sources.length}} 家</text></view>
  <view class="group">
    <view class="list icons">
      <view wx:for="{{ev.sources}}" wx:key="url" class="cell" hover-class="cell-hover" bindtap="copyUrl" data-url="{{item.url}}">
        <icon-tile glyph="link" color="#8E8E93"/>
        <view class="flex1 ml30"><view class="title ellipsis">{{item.site}}</view><view class="sub ellipsis">{{item.title}}</view></view>
        <text class="footnote secondary">{{item.published || ''}}</text>
      </view>
    </view>
    <view class="group-footer">轻点复制链接</view>
  </view>
</view>

<view class="toolbar" wx:if="{{ev}}">
  <view class="btn {{ev.selected ? 'btn-gray danger' : 'btn-tinted'}}" hover-class="hover" bindtap="drop">{{ev.selected ? '剔除' : '保留'}}</view>
  <view class="btn btn-filled" hover-class="hover" bindtap="save">保存</view>
</view>
