<view class="lt-nav" style="padding-top:{{statusBar}}px;">
  <view class="lt-bar"></view>
  <view class="lt-date">{{dateText}}</view>
  <view class="lt-title">
    <text>工作台</text>
    <view class="me" hover-class="hover" bindtap="goSettings">{{meChar}}</view>
  </view>
</view>

<!-- 未授权 -->
<view wx:if="{{!role && loaded}}">
  <empty-state glyph="shield" title="{{bootstrapable ? '欢迎使用' : '需要访问权限'}}"
    desc="{{bootstrapable ? '成为管理员并导入 401 位委员名单，开始生产学术动态。' : '请将下方 OpenID 发送给管理员开通编辑权限。'}}">
    <view wx:if="{{bootstrapable}}" class="btn btn-filled cta" hover-class="hover" bindtap="bootstrap">开始使用</view>
    <view wx:else class="openid" bindtap="copyOpenid">{{openid}}</view>
  </empty-state>
</view>

<view wx:if="{{role}}" class="page">
  <!-- 本期周报：Fitness 圆环小组件 -->
  <view class="group">
    <view class="card hero" hover-class="cell-hover" bindtap="openIssue" data-id="{{weekly._id}}" wx:if="{{weekly}}">
      <view class="widget-head">
        <icon-tile glyph="weekly" color="#007AFF" size="sm"/>
        <text class="ml12 tint">本期周报</text>
        <view class="flex1"></view>
        <status-pill status="{{weekly.status}}"/>
      </view>
      <view class="row mt24">
        <view class="flex1">
          <view class="title1 rounded">第 {{weekly.short}} 期</view>
          <view class="subhead secondary mt4">{{weekly.range}}</view>
          <view class="legend mt24">
            <view class="lg"><view class="ld" style="background:#FF2D55"></view><text class="footnote secondary">采集</text><text class="footnote semibold rounded">{{weekly.progress.done}}/{{weekly.progress.tasks}}</text></view>
            <view class="lg"><view class="ld" style="background:#34C759"></view><text class="footnote secondary">入选</text><text class="footnote semibold rounded">{{weekly.count || weekly.stats.selected || 0}} 条</text></view>
            <view class="lg"><view class="ld" style="background:#00C7BE"></view><text class="footnote secondary">复核</text><text class="footnote semibold rounded">剩 {{weekly.stats.needsReview || 0}} 条</text></view>
          </view>
        </view>
        <activity-rings values="{{rings}}" size="236"/>
      </view>
    </view>
    <view class="card hero" wx:else hover-class="cell-hover" bindtap="start" data-kind="weekly">
      <view class="widget-head"><icon-tile glyph="weekly" color="#007AFF" size="sm"/><text class="ml12 tint">本期周报</text></view>
      <view class="title2 mt24">尚未生成</view>
      <view class="subhead secondary mt4">轻点开始采集上一个完整自然周</view>
    </view>
  </view>

  <!-- 指标小组件 -->
  <view class="grid">
    <view class="card w" hover-class="cell-hover" bindtap="goReview">
      <view class="widget-head"><icon-tile glyph="review" color="#FF9500" size="sm"/><text class="ml12" style="color:#FF9500">待复核</text><view class="flex1"></view><view class="chevron"></view></view>
      <view class="metric mt24">{{pendingReview}}<text class="unit">条</text></view>
      <view class="footnote secondary mt4">人物待确认</view>
    </view>
    <view class="card w" hover-class="cell-hover" bindtap="goMembers">
      <view class="widget-head"><icon-tile glyph="person" color="#007AFF" size="sm"/><text class="ml12 tint">在任委员</text><view class="flex1"></view><view class="chevron"></view></view>
      <view class="metric mt24">{{memberCount}}<text class="unit">位</text></view>
      <view class="footnote secondary mt4">委员名录与画像</view>
    </view>
    <view class="card w" hover-class="cell-hover" bindtap="openMonthly">
      <view class="widget-head"><icon-tile glyph="monthly" color="#5856D6" size="sm"/><text class="ml12" style="color:#5856D6">本月月报</text><view class="flex1"></view><view class="chevron"></view></view>
      <view class="metric mt24" wx:if="{{monthly}}">{{monthly.count || 0}}<text class="unit">条</text></view>
      <view class="metric mt24" wx:else>—</view>
      <view class="footnote secondary mt4">{{monthly ? monthly.monthCn + ' · ' + monthly.statusName : '轻点创建'}}</view>
    </view>
    <view class="card w" hover-class="cell-hover" bindtap="goIssues">
      <view class="widget-head"><icon-tile glyph="review" color="#34C759" size="sm"/><text class="ml12" style="color:#34C759">已发布</text><view class="flex1"></view><view class="chevron"></view></view>
      <view class="metric mt24">{{publishedCount}}<text class="unit">期</text></view>
      <view class="footnote secondary mt4">周报与月报</view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="group-header inset2">快捷操作</view>
  <view class="group">
    <view class="list icons">
      <view class="cell" hover-class="cell-hover" bindtap="start" data-kind="weekly"><icon-tile glyph="weekly" color="#007AFF"/><text class="title flex1 ml30">新建周报</text><view class="chevron"></view></view>
      <view class="cell" hover-class="cell-hover" bindtap="start" data-kind="monthly"><icon-tile glyph="monthly" color="#5856D6"/><text class="title flex1 ml30">新建月报</text><view class="chevron"></view></view>
      <view class="cell" hover-class="cell-hover" bindtap="goRoster"><icon-tile glyph="roster" color="#34C759"/><text class="title flex1 ml30">名单变更</text><view class="chevron"></view></view>
      <view class="cell" hover-class="cell-hover" bindtap="goSettings"><icon-tile glyph="settings" color="#8E8E93"/><text class="title flex1 ml30">系统设置</text><view class="chevron"></view></view>
    </view>
  </view>

  <!-- 名单动态 -->
  <view class="group-header inset2"><text>名单动态</text><text class="action" bindtap="goRoster">导入</text></view>
  <view class="group">
    <view class="list icons">
      <view wx:for="{{changes}}" wx:key="_id" class="cell" hover-class="cell-hover" bindtap="openMember" data-id="{{item.memberId}}">
        <icon-tile glyph="{{changeMeta[item.type].glyph}}" color="{{changeMeta[item.type].color}}" size="round"/>
        <view class="flex1 ml30"><view class="title">{{item.name}}</view><view class="sub">{{changeMeta[item.type].name}}</view></view>
        <text class="footnote secondary">{{item.date}}</text>
      </view>
      <view wx:if="{{!changes.length}}" class="cell"><text class="secondary">暂无变更记录</text></view>
    </view>
  </view>
</view>
