.ml12 { margin-left: 12rpx; } .ml30 { margin-left: 30rpx; } .mt4 { margin-top: 4rpx; } .mt24 { margin-top: 24rpx; }
.me { width: 64rpx; height: 64rpx; border-radius: 50%; background: linear-gradient(180deg, #A5ABB8, #858994); color: #fff; font-size: 28rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.inset2 { margin: 0 32rpx; }
.hero { padding: 28rpx 32rpx 32rpx; }
.legend .lg { display: flex; align-items: center; margin-top: 8rpx; }
.legend .ld { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 12rpx; }
.legend .lg text + text { margin-left: 12rpx; }
.grid { display: flex; flex-wrap: wrap; margin: -56rpx 16rpx 40rpx; padding-top: 0; }
.grid .w { width: calc(50% - 32rpx); margin: 16rpx; box-sizing: border-box; padding: 24rpx 28rpx 28rpx; }
.cta { margin-top: 40rpx; width: 480rpx; }
.openid { margin-top: 32rpx; font-size: 26rpx; color: var(--tint); word-break: break-all; padding: 24rpx; background: var(--card); border-radius: 20rpx; }
.hints { margin-top: 40rpx; text-align: left; line-height: 1.7; background: var(--card); border-radius: 20rpx; padding: 24rpx 28rpx; }
.copy { margin-top: 28rpx; font-size: 30rpx; }
