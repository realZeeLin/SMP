<view class="container">
  <view class="segment">
    <view class="seg {{kind === '' ? 'on' : ''}}" data-k="" bindtap="switch">全部</view>
    <view class="seg {{kind === 'weekly' ? 'on' : ''}}" data-k="weekly" bindtap="switch">周报</view>
    <view class="seg {{kind === 'monthly' ? 'on' : ''}}" data-k="monthly" bindtap="switch">月报</view>
  </view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="_id" class="issue" bindtap="open" data-id="{{item._id}}">
      <view class="spine {{item.kind}}">
        <view class="sk">{{item.kindName}}</view>
        <view class="sn serif">{{item.short}}</view>
        <view class="sy num">{{item.year}}</view>
      </view>
      <view class="body flex1">
        <view class="between"><view class="t serif ellipsis">{{item.title || ('委员学术动态' + item.kindName)}}</view></view>
        <view class="sub mt4">{{item.range}}</view>
        <view class="meta">
          <status-pill status="{{item.status}}"/>
          <text class="muted ml16">入选 <text class="num">{{item.count || 0}}</text> · 候选 <text class="num">{{item.stats.events || 0}}</text></text>
        </view>
      </view>
    </view>
  </view>
  <empty-state wx:if="{{loaded && !list.length}}" title="还没有期刊" desc="在工作台新建周报或月报"/>
  <view wx:if="{{hasMore}}" class="more muted" bindtap="loadMore">加载更多</view>
</view>
