.mt4 { margin-top: 4rpx; } .mt16 { margin-top: 16rpx; } .mt20 { margin-top: 20rpx; } .ml24 { margin-left: 24rpx; }
.inset2 { margin: 0 32rpx; }
.list.cal .cell + .cell::before { left: 136rpx; }
.calendar { width: 80rpx; height: 84rpx; border-radius: 16rpx; background: var(--card); overflow: hidden; box-shadow: 0 0 0 1rpx var(--sep), 0 2rpx 6rpx rgba(0, 0, 0, 0.06); flex-shrink: 0; text-align: center; }
.cal-top { height: 24rpx; line-height: 24rpx; font-size: 16rpx; font-weight: 600; color: #fff; }
.cal-num { font-size: 40rpx; font-weight: 600; line-height: 58rpx; color: var(--label); }
.more { text-align: center; padding: 24rpx; }
