.mt4 { margin-top: 4rpx; } .mt16 { margin-top: 16rpx; } .mt24 { margin-top: 24rpx; } .ml16 { margin-left: 16rpx; } .ml30 { margin-left: 30rpx; }
.inset2 { margin: 0 32rpx; }
.center { justify-content: center; }
.card-head { display: flex; flex-direction: column; align-items: center; padding: 24rpx 48rpx 32rpx; text-align: center; }
.capsule.role { color: var(--tint); background: rgba(0, 122, 255, 0.12); margin: 0 6rpx 8rpx; }
.capsule.ver { color: #34C759; background: rgba(52, 199, 89, 0.15); margin: 0 6rpx 8rpx; }
.actions { display: flex; margin: 0 32rpx 32rpx; }
.act { flex: 1; height: 116rpx; background: var(--card); border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 24rpx; color: var(--tint); }
.act + .act { margin-left: 16rpx; }
.act image { width: 44rpx; height: 44rpx; margin-bottom: 6rpx; }
.stats { display: flex; padding: 24rpx 0; }
.st { flex: 1; text-align: center; position: relative; }
.st + .st::before { content: ""; position: absolute; left: 0; top: 12rpx; bottom: 12rpx; width: 1rpx; background: var(--sep); }
.st .metric { font-size: 48rpx; }
.kv { align-items: flex-start; }
.kv .k { width: 180rpx; flex-shrink: 0; font-size: 30rpx; color: var(--label2); padding-top: 2rpx; }
.kv .v { flex: 1; min-width: 0; font-size: 32rpx; line-height: 1.4; }
.tagf { font-size: 26rpx; background: var(--fill); color: var(--label); border-radius: 10rpx; padding: 4rpx 14rpx; margin: 0 10rpx 10rpx 0; }
.tagf.green { background: rgba(52, 199, 89, 0.15); color: #248A3D; }
.tagf.red { background: rgba(255, 59, 48, 0.12); color: #D70015; }
.col { flex-direction: column; align-items: stretch; }
.ta { width: 100%; margin-top: 6rpx; line-height: 1.4; min-height: 48rpx; }
