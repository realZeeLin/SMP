.mt12 { margin-top: 12rpx; } .mt24 { margin-top: 24rpx; } .ml20 { margin-left: 20rpx; } .ml28 { margin-left: 28rpx; } .mr8 { margin-right: 8rpx; }
.hero { background: linear-gradient(180deg, #1B2B48 0%, #22365A 100%); color: #fff; padding: 24rpx 32rpx 0; }
.hn { font-size: 48rpx; font-weight: 700; letter-spacing: 4rpx; }
.verified { font-family: var(--sans); font-size: 20rpx; color: #1B2B48; background: #E3C892; border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 16rpx; vertical-align: middle; letter-spacing: 0; }
.ho { font-size: 26rpx; color: rgba(255, 255, 255, 0.72); margin-top: 4rpx; }
.hr { font-size: 20rpx; color: #E3C892; border: 1rpx solid rgba(227, 200, 146, 0.5); border-radius: 6rpx; padding: 0 12rpx; margin: 0 12rpx 8rpx 0; }
.hstats { display: flex; margin-top: 32rpx; padding: 24rpx 0 28rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.12); }
.hs { flex: 1; } .hs .v { font-size: 32rpx; font-weight: 700; } .hs .k { font-size: 20rpx; color: rgba(255, 255, 255, 0.55); }
.kv { display: flex; padding: 14rpx 0; font-size: 26rpx; }
.kv .k { width: 150rpx; color: var(--muted); flex-shrink: 0; }
.kv .v { flex: 1; color: var(--text); min-width: 0; }
.link { color: var(--accent); }
.chip.pos { background: #E4F1EA; color: var(--green); }
.chip.neg { background: #F6E7E5; color: var(--red); }
.cb { width: 32rpx; height: 32rpx; border: 2rpx solid #C9CDD4; border-radius: 6rpx; margin-right: 12rpx; }
.cb.on { background: var(--ink); border-color: var(--ink); }
.timeline { position: relative; padding-left: 36rpx; }
.timeline::before { content: ""; position: absolute; left: 10rpx; top: 12rpx; bottom: 12rpx; width: 2rpx; background: #E1DED6; }
.tl { position: relative; margin-bottom: 24rpx; }
.tl-dot { position: absolute; left: -34rpx; top: 12rpx; width: 18rpx; height: 18rpx; border-radius: 50%; border: 4rpx solid var(--paper); }
.tl-date { font-size: 22rpx; color: var(--muted); }
.tl-card { background: #fff; border: 1rpx solid var(--line); border-radius: 12rpx; padding: 20rpx 24rpx; margin-top: 8rpx; }
.tl-t { font-size: 27rpx; color: var(--ink); font-weight: 600; margin: 10rpx 0 4rpx; line-height: 1.5; }
.pad { padding: 16rpx 0; }
.chg { display: flex; padding: 22rpx 28rpx; font-size: 25rpx; }
.chg + .chg { border-top: 1rpx solid var(--line); }
