<view class="lt-nav head" style="padding-top:{{statusBar}}px;">
  <view class="lt-bar"></view>
  <view class="lt-title"><text>委员</text><text class="add tint" bindtap="goRoster">名单变更</text></view>
  <view class="searchfield mt16">
    <image src="/images/glyph/search-gray.png"/>
    <input class="flex1" placeholder="姓名、单位或研究方向" placeholder-class="ph" confirm-type="search" value="{{q}}" bindinput="onInput" bindconfirm="onSearch"/>
  </view>
  <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
    <view class="chip {{role === '' ? 'on' : ''}}" data-r="" bindtap="pickRole">全部</view>
    <view wx:for="{{roles}}" wx:key="*this" class="chip {{role === item ? 'on' : ''}}" data-r="{{item}}" bindtap="pickRole">{{item}}</view>
  </scroll-view>
</view>

<view class="contacts">
  <view class="me-card">
    <view class="mono lg">SMP</view>
    <view class="flex1 ml24"><view class="title3">社会媒体处理专委会</view><view class="subhead secondary">{{total}} 位{{role || '在任委员'}}</view></view>
  </view>
  <view wx:for="{{sections}}" wx:for-item="sec" wx:key="key" id="sec-{{sec.key}}">
    <view class="sec-h">{{sec.key}}</view>
    <view class="plain">
      <view wx:for="{{sec.list}}" wx:key="_id" class="prow" hover-class="cell-hover" bindtap="open" data-id="{{item._id}}">
        <view class="mono">{{item.char}}</view>
        <view class="flex1 ml24 pbody">
          <view class="row"><text class="body semibold">{{item.name}}</text><text wx:if="{{item.homonym}}" class="capsule hom">同名</text></view>
          <view class="subhead secondary ellipsis">{{item.org}} · {{item.roleText}}</view>
        </view>
      </view>
    </view>
  </view>
  <empty-state wx:if="{{loaded && !sections.length}}" glyph="person" title="没有匹配的委员"/>
</view>

<view class="index" wx:if="{{sections.length > 6}}">
  <view wx:for="{{sections}}" wx:key="key" class="ix" data-k="{{item.key}}" bindtap="jump">{{item.key}}</view>
</view>
