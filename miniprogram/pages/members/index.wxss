.mt16 { margin-top: 16rpx; } .ml24 { margin-left: 24rpx; }
.head { padding-bottom: 20rpx; }
.add { font-size: 34rpx; font-weight: 400; letter-spacing: 0; }
.chips { white-space: nowrap; margin-top: 20rpx; }
.chips .chip { display: inline-flex; }
.contacts { background: var(--card); min-height: 100vh; padding-bottom: 64rpx; }
.me-card { display: flex; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--sep); }
.mono.lg { width: 120rpx; height: 120rpx; font-size: 36rpx; background: linear-gradient(180deg, #4F8EF7, #1D5FD6); }
.sec-h { position: sticky; top: 0; padding: 8rpx 32rpx; font-size: 30rpx; font-weight: 600; color: var(--label2); background: var(--card); }
.prow { display: flex; align-items: center; padding: 0 56rpx 0 32rpx; height: 120rpx; }
.pbody { height: 120rpx; display: flex; flex-direction: column; justify-content: center; border-bottom: 1rpx solid var(--sep); }
.hom { height: 36rpx; font-size: 20rpx; margin-left: 12rpx; color: #FF9500; background: rgba(255, 149, 0, 0.15); }
.index { position: fixed; right: 4rpx; top: 50%; transform: translateY(-50%); z-index: 20; display: flex; flex-direction: column; align-items: center; }
.ix { font-size: 22rpx; font-weight: 600; color: var(--tint); padding: 2rpx 10rpx; line-height: 1.25; }
