<view class="container" wx:if="{{issue}}">
  <view class="between issue-bar" bindtap="pickIssue">
    <view>
      <view class="eyebrow">REVIEW</view>
      <view class="h2">{{issue.kindName}} · {{issue.no}}</view>
    </view>
    <view class="switch sub">{{issue.range}} ⌄</view>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'on' : ''}}" data-k="{{item.key}}" bindtap="switchTab">
      {{item.name}}<text wx:if="{{item.n !== undefined}}" class="n num">{{item.n}}</text>
    </view>
  </view>

  <view wx:if="{{issue.dirty}}" class="banner gold" bindtap="reanalyze"><text>已有调整，重新编排后进入稿件</text><text class="act">重新编排 ›</text></view>

  <!-- 已过滤 -->
  <block wx:if="{{tab === 'filtered'}}">
    <view wx:for="{{list}}" wx:key="_id" class="card fcard">
      <view class="row"><view class="reason">{{item.reason}}</view><text class="muted ml12 ellipsis flex1">{{item.memberNames}}</text></view>
      <view class="ft clamp2">{{item.title}}</view>
      <view class="muted ellipsis">{{item.url}}</view>
    </view>
  </block>

  <!-- 事件卡 -->
  <block wx:else>
    <view wx:for="{{list}}" wx:key="_id" class="card ev {{item.needsReview ? 'attention' : ''}}">
      <view class="between">
        <cat-tag category="{{item.category}}"/>
        <view class="row">
          <view wx:if="{{item.decisionName}}" class="decided">{{item.decisionName}}</view>
          <view class="score num">{{item.scoreText}}</view>
        </view>
      </view>
      <view class="et serif" bindtap="open" data-id="{{item._id}}">{{item.headline || item.title}}</view>
      <view class="row wrap mt12">
        <view wx:for="{{item.memberNames}}" wx:for-item="n" wx:for-index="mi" wx:key="*this" class="person">
          <text class="pn">{{n}}</text><text class="po">{{item.memberOrgs[mi]}}</text>
        </view>
      </view>
      <view class="row mt12">
        <view class="conf"><view class="cbar" style="width:{{item.confPct}}%;background:{{item.confPct >= 60 ? '#2F7A5B' : '#A8834A'}}"></view></view>
        <text class="muted ml12">人物置信 {{item.confPct}}%</text>
        <text class="muted ml12">· {{item.sources.length}} 家报道</text>
      </view>
      <view wx:if="{{item.reviewNotes.length}}" class="notes">{{item.reviewNotes[0]}}</view>
      <view class="ops">
        <view class="op keep" data-id="{{item._id}}" data-d="keep" bindtap="decide">保留</view>
        <view class="op" data-id="{{item._id}}" data-d="drop" bindtap="decide">剔除</view>
        <view class="op" data-id="{{item._id}}" data-d="wrong_person" bindtap="decide">认错人</view>
        <view class="op confirm" data-id="{{item._id}}" data-d="confirm" bindtap="decide">人物无误</view>
      </view>
    </view>
  </block>

  <empty-state wx:if="{{loaded && !list.length}}" title="{{tab === 'review' ? '没有待复核条目' : '暂无数据'}}" desc="{{tab === 'review' ? '本期人物识别均已确认' : ''}}"/>
  <view wx:if="{{hasMore}}" class="more muted" bindtap="loadMore">加载更多</view>
</view>
<empty-state wx:if="{{loaded && !issue}}" title="暂无可复核的期刊" desc="在工作台新建周报，采集完成后即可复核"/>
