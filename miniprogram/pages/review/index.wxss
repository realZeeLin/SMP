.mt12 { margin-top: 12rpx; } .ml12 { margin-left: 12rpx; }
.issue-bar { padding: 8rpx 0 24rpx; }
.switch { background: #fff; border: 1rpx solid var(--line); border-radius: 30rpx; padding: 8rpx 22rpx; }
.tabs { display: flex; border-bottom: 1rpx solid var(--line); margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 18rpx 0 20rpx; font-size: 26rpx; color: var(--sub); position: relative; }
.tab.on { color: var(--ink); font-weight: 700; }
.tab.on::after { content: ""; position: absolute; left: 50%; bottom: -1rpx; width: 48rpx; margin-left: -24rpx; height: 4rpx; border-radius: 2rpx; background: var(--ink); }
.n { margin-left: 6rpx; font-size: 20rpx; color: var(--muted); }
.tab.on .n { color: var(--gold); }
.ev { padding: 28rpx; }
.ev.attention { border-color: #E6D3AE; box-shadow: 0 4rpx 24rpx rgba(168, 131, 74, 0.10); }
.et { font-size: 30rpx; font-weight: 700; color: var(--ink); line-height: 1.5; margin-top: 16rpx; }
.score { font-size: 24rpx; color: var(--accent); background: #EEF2F8; border-radius: 8rpx; padding: 2rpx 12rpx; }
.decided { font-size: 20rpx; color: var(--green); margin-right: 12rpx; }
.person { display: inline-flex; align-items: baseline; margin: 0 20rpx 8rpx 0; }
.pn { font-size: 26rpx; font-weight: 600; color: var(--text); }
.po { font-size: 22rpx; color: var(--muted); margin-left: 8rpx; }
.conf { width: 120rpx; height: 8rpx; background: #EEF0F3; border-radius: 4rpx; overflow: hidden; }
.cbar { height: 100%; border-radius: 4rpx; }
.notes { margin-top: 16rpx; font-size: 22rpx; color: #8C6A33; background: var(--gold-soft); border-radius: 8rpx; padding: 10rpx 16rpx; }
.ops { display: flex; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.op { flex: 1; text-align: center; font-size: 24rpx; color: var(--sub); height: 56rpx; line-height: 56rpx; border-radius: 8rpx; }
.op + .op { margin-left: 12rpx; }
.op.keep { color: var(--ink); background: #EEF2F8; font-weight: 600; }
.op.confirm { color: var(--green); background: #E4F1EA; font-weight: 600; }
.fcard { padding: 24rpx 28rpx; }
.reason { font-size: 20rpx; color: var(--red); background: #F6E7E5; border-radius: 6rpx; padding: 2rpx 10rpx; flex-shrink: 0; }
.ft { font-size: 26rpx; color: var(--text); margin: 10rpx 0 6rpx; }
.more { text-align: center; padding: 24rpx; }
