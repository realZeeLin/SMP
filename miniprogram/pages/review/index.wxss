.mt4 { margin-top: 4rpx; } .mt8 { margin-top: 8rpx; } .mt12 { margin-top: 12rpx; } .mt20 { margin-top: 20rpx; } .mt24 { margin-top: 24rpx; }
.ml8 { margin-left: 8rpx; } .ml12 { margin-left: 12rpx; } .ml16 { margin-left: 16rpx; }
.sticky { position: sticky; top: 0; z-index: 10; }
.picker { display: flex; align-items: center; font-size: 30rpx; font-weight: 600; color: var(--tint); background: var(--fill); border-radius: 30rpx; height: 60rpx; padding: 0 22rpx; letter-spacing: 0; }
.down { width: 12rpx; height: 12rpx; border-right: 4rpx solid var(--tint); border-bottom: 4rpx solid var(--tint); transform: rotate(45deg); margin: -8rpx 0 0 14rpx; }
.hint { padding: 0 32rpx 14rpx; }
.col { flex-direction: column; align-items: stretch; padding: 26rpx 32rpx 28rpx; background: var(--card); }
.person { display: inline-flex; align-items: center; margin: 0 24rpx 8rpx 0; }
.mono.sm { width: 44rpx; height: 44rpx; font-size: 22rpx; margin-right: 10rpx; }
.conf { width: 120rpx; }
.why { display: flex; align-items: flex-start; margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: rgba(255, 149, 0, 0.12); color: #C77700; font-size: 26rpx; line-height: 1.4; }
.why image { width: 30rpx; height: 30rpx; border-radius: 50%; background: #FF9500; margin: 2rpx 10rpx 0 0; flex-shrink: 0; }
.ok { background: rgba(52, 199, 89, 0.15); color: #248A3D; }
.decided { color: #34C759; margin-right: 12rpx; font-weight: 600; }
.capsule.red { color: #FF3B30; background: rgba(255, 59, 48, 0.15); height: 40rpx; font-size: 22rpx; flex-shrink: 0; }
.more { text-align: center; padding: 24rpx; }
/* WeUI slideview 按钮着色（iOS 滑动操作配色） */
.sv-keep { background: #007AFF !important; color: #fff !important; }
.sv-drop { background: #FF3B30 !important; color: #fff !important; }
