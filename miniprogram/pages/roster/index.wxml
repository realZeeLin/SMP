<view class="with-toolbar pt24">
  <view class="group-header inset2">名单文本</view>
  <view class="group">
    <view class="list">
      <view class="cell col">
        <textarea class="paste" maxlength="-1" value="{{text}}" placeholder="粘贴官网“委员介绍”全文，或 CSV（name,org,roles）" placeholder-class="tertiary" bindinput="onText"/>
      </view>
      <view class="cell" hover-class="cell-hover" bindtap="pasteClipboard"><icon-tile glyph="copy" color="#007AFF"/><text class="title flex1 ml30 tint">从剪贴板粘贴</text><text class="value">{{lines}} 行</text></view>
    </view>
  </view>

  <view class="group">
    <view class="list">
      <picker mode="date" value="{{effective}}" bindchange="onDate">
        <view class="cell" hover-class="cell-hover"><text class="title flex1">生效日期</text><text class="value rounded">{{effective}}</text><view class="chevron"></view></view>
      </picker>
      <view class="cell"><text class="title">来源说明</text><input class="flex1 right" value="{{source}}" bindinput="onSource" placeholder="如：第十届换届名单" placeholder-class="tertiary"/></view>
    </view>
    <view class="group-footer">系统自动识别新增、离任、身份与单位变化；委员 ID 与画像保持不变，离任委员保留档案。</view>
  </view>

  <block wx:if="{{preview}}">
    <view class="group-header inset2"><text>变更预览</text><text>共解析 {{preview.total}} 人</text></view>
    <view class="group">
      <view class="list summary">
        <view class="sm"><view class="metric" style="color:#34C759">{{preview.summary.added}}</view><view class="caption secondary">新增</view></view>
        <view class="sm"><view class="metric" style="color:#FF3B30">{{preview.summary.removed}}</view><view class="caption secondary">离任</view></view>
        <view class="sm"><view class="metric" style="color:#007AFF">{{preview.summary.roleChanged}}</view><view class="caption secondary">身份</view></view>
        <view class="sm"><view class="metric" style="color:#FF9500">{{preview.summary.orgChanged}}</view><view class="caption secondary">单位</view></view>
        <view class="sm"><view class="metric">{{preview.summary.unchanged}}</view><view class="caption secondary">未变</view></view>
      </view>
    </view>
    <view class="group">
      <view class="list icons">
        <view wx:for="{{preview.changes}}" wx:key="memberId" class="cell">
          <icon-tile glyph="{{meta[item.type].glyph}}" color="{{meta[item.type].color}}" size="round"/>
          <view class="flex1 ml30"><view class="title">{{item.name}}</view><view class="sub">{{item.desc}}</view></view>
          <text class="footnote secondary">{{meta[item.type].name}}</text>
        </view>
        <view wx:if="{{!preview.changes.length}}" class="cell"><text class="secondary">名单无变化</text></view>
      </view>
      <view wx:if="{{preview.summary.orgChanged}}" class="group-footer">单位变化按“同名且唯一”自动判定为同一人，请逐条核对。</view>
    </view>
  </block>

  <view class="group-header inset2">历史版本</view>
  <view class="group">
    <view class="list">
      <view wx:for="{{versions}}" wx:key="_id" class="cell"><view class="flex1"><view class="title">{{item.source || '名单导入'}}</view><view class="sub">{{item.total}} 人 · 新增 {{item.summary.added}} · 离任 {{item.summary.removed}}</view></view><text class="footnote secondary rounded">{{item.effective}}</text></view>
      <view wx:if="{{!versions.length}}" class="cell"><text class="secondary">暂无</text></view>
    </view>
  </view>
</view>

<view class="toolbar">
  <view class="btn btn-tinted" hover-class="hover" bindtap="doPreview">预览变更</view>
  <view class="btn btn-filled {{preview ? '' : 'disabled'}}" hover-class="hover" bindtap="apply">确认导入</view>
</view>
