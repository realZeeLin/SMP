<view class="with-toolbar pt24" wx:if="{{s}}">
  <view class="group-header inset2">DeepSeek 开放搜索</view>
  <view class="group">
    <view class="list icons">
      <view class="cell"><icon-tile glyph="key" color="#8E8E93"/><text class="title flex1 ml30">API Key</text><text class="value" style="color:{{apiKey ? '#34C759' : '#FF3B30'}}">{{apiKey ? '已配置' : '未配置'}}</text></view>
      <view class="cell"><icon-tile glyph="search" color="#007AFF"/><text class="title flex1 ml30">Search 接口</text><text class="value footnote">{{s.deepseek.search.endpoint}}</text></view>
      <view class="cell"><icon-tile glyph="doc" color="#30B0C7"/><text class="title flex1 ml30">Fetch 接口</text><text class="value footnote">{{s.deepseek.fetch.endpoint}}</text></view>
      <view class="cell"><icon-tile glyph="tray" color="#5856D6"/><text class="title flex1 ml30">每次返回条数</text>
        <view class="stepper"><view class="sb" hover-class="hover" data-path="deepseek.search.count" data-d="-5" data-min="5" data-max="50" bindtap="onStep">−</view><view class="sd"></view><view class="sb" hover-class="hover" data-path="deepseek.search.count" data-d="5" data-min="5" data-max="50" bindtap="onStep">＋</view></view>
        <text class="value rounded vw">{{s.deepseek.search.count}}</text></view>
      <view class="cell"><icon-tile glyph="bolt" color="#FF9500"/><text class="title flex1 ml30">限速 QPS</text>
        <view class="stepper"><view class="sb" hover-class="hover" data-path="deepseek.qps" data-d="-1" data-min="1" data-max="20" bindtap="onStep">−</view><view class="sd"></view><view class="sb" hover-class="hover" data-path="deepseek.qps" data-d="1" data-min="1" data-max="20" bindtap="onStep">＋</view></view>
        <text class="value rounded vw">{{s.deepseek.qps}}</text></view>
      <view class="cell"><icon-tile glyph="link" color="#34C759"/><text class="title flex1 ml30">回查正文（Fetch）</text><switch color="#34C759" checked="{{s.collect.verify_urls}}" data-path="collect.verify_urls" bindchange="onSwitch"/></view>
    </view>
    <view class="group-footer">API Key 保存在云函数 smp 的环境变量 DEEPSEEK_API_KEY 中，小程序端不可见。</view>
  </view>

  <view wx:for="{{kinds}}" wx:key="k">
    <view class="group-header inset2">{{item.name}}选稿</view>
    <view class="group">
      <view class="list">
        <view class="cell"><text class="title flex1">最少条数</text><input class="num-in rounded" type="number" value="{{item.cfg.min_items}}" data-path="selection.{{item.k}}.min_items" bindblur="onNum"/></view>
        <view class="cell"><text class="title flex1">最多条数</text><input class="num-in rounded" type="number" value="{{item.cfg.max_items}}" data-path="selection.{{item.k}}.max_items" bindblur="onNum"/></view>
        <view class="cell"><text class="title flex1">入选分数线</text><input class="num-in rounded" type="number" value="{{item.cfg.min_score}}" data-path="selection.{{item.k}}.min_score" bindblur="onNum"/></view>
        <view class="cell"><text class="title flex1">每位委员上限</text><input class="num-in rounded" type="number" value="{{item.cfg.per_member_cap}}" data-path="selection.{{item.k}}.per_member_cap" bindblur="onNum"/></view>
      </view>
    </view>
  </view>
  <view class="group">
    <view class="list"><view class="cell"><text class="title flex1">只收录学术动态</text><switch color="#34C759" checked="{{s.academic_filter.enabled}}" data-path="academic_filter.enabled" bindchange="onSwitch"/></view></view>
    <view class="group-footer">过滤商业、娱乐、行政通知等非学术内容，过滤原因可在“复核 → 已过滤”中查看。</view>
  </view>

  <view class="group-header inset2"><text>重要性权重</text><text class="rounded" style="color:{{weightSum === 100 ? 'inherit' : '#FF3B30'}}">合计 {{weightSum}}%</text></view>
  <view class="group">
    <view class="list">
      <view wx:for="{{weights}}" wx:key="k" class="cell">
        <text class="subhead sk">{{item.name}}</text>
        <slider class="flex1 sl" min="0" max="50" step="1" value="{{item.v}}" activeColor="#007AFF" backgroundColor="#E5E5EA" block-size="24" data-k="{{item.k}}" bindchange="onWeight"/>
        <text class="subhead secondary rounded sv">{{item.v}}%</text>
      </view>
    </view>
  </view>

  <view class="group-header inset2">人物消歧</view>
  <view class="group">
    <view class="list">
      <view class="cell"><text class="subhead sk">确认阈值</text><slider class="flex1 sl" min="40" max="90" value="{{confirmPct}}" activeColor="#34C759" backgroundColor="#E5E5EA" block-size="24" data-path="disambiguation.confirm_threshold" bindchange="onPct"/><text class="subhead secondary rounded sv">{{confirmPct}}%</text></view>
      <view class="cell"><text class="subhead sk">否定阈值</text><slider class="flex1 sl" min="10" max="60" value="{{rejectPct}}" activeColor="#FF3B30" backgroundColor="#E5E5EA" block-size="24" data-path="disambiguation.reject_threshold" bindchange="onPct"/><text class="subhead secondary rounded sv">{{rejectPct}}%</text></view>
      <view class="cell"><text class="title flex1">DeepSeek 裁决模糊条目</text><switch color="#34C759" checked="{{s.disambiguation.use_llm_for_ambiguous}}" data-path="disambiguation.use_llm_for_ambiguous" bindchange="onSwitch"/></view>
    </view>
    <view class="group-footer">置信度介于两个阈值之间的人物，交给 DeepSeek 裁决；仍不确定的进入人工复核。</view>
  </view>

  <view class="group-header inset2">定时生成</view>
  <view class="group">
    <view class="list icons">
      <picker range="{{weekdays}}" value="{{s.schedule.weekly.weekday}}" data-path="schedule.weekly.weekday" bindchange="onPick">
        <view class="cell" hover-class="cell-hover"><icon-tile glyph="weekly" color="#FF3B30"/><text class="title flex1 ml30">周报</text><text class="value">{{weekdays[s.schedule.weekly.weekday]}} {{s.schedule.weekly.hour}}:00</text><view class="chevron"></view></view>
      </picker>
      <view class="cell"><icon-tile glyph="monthly" color="#5856D6"/><text class="title flex1 ml30">月报</text><text class="value">每月 {{s.schedule.monthly.day}} 日 {{s.schedule.monthly.hour}}:00</text></view>
      <view class="cell"><icon-tile glyph="clock" color="#FF9500"/><text class="title flex1 ml30">采集完成自动成稿</text><switch color="#34C759" checked="{{s.schedule.auto_compose}}" data-path="schedule.auto_compose" bindchange="onSwitch"/></view>
    </view>
  </view>

  <view class="group-header inset2">成员与权限</view>
  <view class="group">
    <view class="list avatars">
      <view wx:for="{{admins}}" wx:key="_id" class="cell"><view class="mono">{{item.char}}</view><view class="flex1 ml24"><view class="title">{{item.name}}</view><view class="sub ellipsis">{{item.openid}}</view></view><text class="value footnote">{{item.role === 'admin' ? '管理员' : '编辑'}}</text></view>
      <view class="cell" hover-class="cell-hover" bindtap="addAdmin"><text class="title tint">添加编辑…</text></view>
    </view>
  </view>
</view>

<view class="toolbar" wx:if="{{s}}">
  <view class="btn btn-gray" hover-class="hover" bindtap="reset">还原</view>
  <view class="btn btn-filled" hover-class="hover" bindtap="save">保存</view>
</view>
