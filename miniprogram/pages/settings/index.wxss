.mt8 { margin-top: 8rpx; } .ml20 { margin-left: 20rpx; }
.first { margin-top: 8rpx; }
.state { font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 6rpx; }
.state.ok { background: #E4F1EA; color: var(--green); } .state.no { background: #F6E7E5; color: var(--red); }
.kv { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; font-size: 26rpx; }
.kv .k { color: var(--sub); } .kv .v { color: var(--ink); }
.kind + .kind { margin-top: 28rpx; }
.grid { display: flex; flex-wrap: wrap; margin: 16rpx -8rpx 12rpx; }
.g { width: 50%; padding: 8rpx; box-sizing: border-box; }
.gl { font-size: 22rpx; color: var(--muted); margin-bottom: 8rpx; }
.slider-row { display: flex; align-items: center; padding: 4rpx 0; }
.sk { width: 150rpx; font-size: 24rpx; color: var(--sub); }
.sv { width: 80rpx; text-align: right; font-size: 24rpx; color: var(--ink); }
.pick { color: var(--ink); font-size: 26rpx; }
.adm { display: flex; align-items: center; padding: 22rpx 28rpx; font-size: 26rpx; }
.adm + .adm { border-top: 1rpx solid var(--line); }
.adm.add { color: var(--accent); justify-content: center; }
.stepper { display: flex; align-items: center; border: 1rpx solid #D9DCE2; border-radius: 10rpx; overflow: hidden; }
.sb { width: 56rpx; height: 52rpx; line-height: 52rpx; text-align: center; color: var(--ink); background: #F7F7F8; font-size: 28rpx; }
.sn { min-width: 64rpx; text-align: center; font-size: 26rpx; color: var(--ink); }
