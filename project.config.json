  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "legacy" },
      { "type": "folder", "value": "design" },
      { "type": "folder", "value": "tests" },
      { "type": "folder", "value": "database" },
      { "type": "folder", "value": "docs" }
    ]
  },
  "condition": {}
}
